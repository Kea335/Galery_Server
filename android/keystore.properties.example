# Copy to android/keystore.properties and fill in. That file is git-ignored.
#
# Create the keystore first — pick your own passwords, and keep a backup
# somewhere that is not this machine. If this file is lost, the app can never be
# updated in place again; a new key means a new app as far as Android is
# concerned.
#
#   keytool -genkeypair -v \
#     -keystore kadr-release.jks \
#     -alias kadr \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is resolved from the android/ directory, so a keystore sitting next
# to this file is just its name. Keeping it outside the repo is safer still:
#   storeFile=../../kadr-release.jks

storeFile=kadr-release.jks
storePassword=
keyAlias=kadr
keyPassword=
