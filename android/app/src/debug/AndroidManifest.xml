<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds talk to the server over plain HTTP on the LAN so the API can be
  exercised before Caddy's internal CA is installed on the phone (§13). Release
  builds keep cleartext blocked.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:usesCleartextTraffic="true" />
</manifest>
