<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Dark-first (§12). The real palette lives in Compose; this only covers the
      window before the first frame, so the launch never flashes white.
    -->
    <style name="Theme.Kadr" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/kadr_base</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
