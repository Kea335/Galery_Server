node_modules/
*.log
.env

# Server runtime state and test scratch. These are anchored with a leading
# slash on purpose: a bare `data/` would also swallow the Android source
# package com/kadr/app/data/.
/server/data/
/server/.e2e-tmp/
/server/.restart-tmp/
/server/.restart-data/
/server/.mem-tmp/

# Android
.gradle/
build/
local.properties
*.apk

# The release signing key and its passwords. On Android the key *is* the app's
# identity: anyone holding it can publish something that installs straight over
# this one, and it cannot be rotated for an app already out there.
*.keystore
*.jks
keystore.properties

/server/.soak-data/
/server/.soak-tmp/
/server/.hardening-data/
/server/.hardening-tmp/
